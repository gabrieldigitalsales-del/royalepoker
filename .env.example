# Local: nenhuma credencial obrigatória.
HOST=127.0.0.1
PORT=4190
DATA_FILE=data/mesa.sqlite
# Defina antes de cadastrar a conta que administrará o clube.
ADMIN_EMAIL=
# Nuvem: conexão PostgreSQL direta ou session pooler, com TLS.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Origem exata do frontend quando ele estiver em outro domínio.
FRONTEND_ORIGIN=
# Variáveis de build do Vite. Vazio usa a origem atual.
VITE_SERVER_URL=
VITE_USE_AUTH_EDGE=0

# Opcional: código compartilhado exigido para novos cadastros no modo local.
CLUB_BETA_CODE=
