{
  "name": "mesa-real",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/start.mjs --dev",
    "start": "node server/start.mjs",
    "build": "npm run build:web && node bundle.mjs",
    "test": "node --test --test-concurrency=4 tests/*.test.mjs",
    "build:web": "tsc --noEmit && vite build",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src server/*.mjs tests/*.mjs",
    "dev:server": "node server/start.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "check:server": "node scripts/check-backend.mjs",
    "test:smoke": "node --test tests/royale-runout-showdown-headsup.test.mjs tests/cucurucho-regression.test.mjs tests/showdown-flow-unified.test.mjs tests/reveal-privacy-and-personalization.test.mjs tests/runout-two-three-layout.test.mjs tests/royale-visual-runout.test.mjs tests/board-results.test.mjs tests/runout-double-board.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "ws": "^8.18.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "postcss": "^8.5.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0",
    "vite": "^6.4.0"
  },
  "engines": {
    "node": ">=24"
  }
}
